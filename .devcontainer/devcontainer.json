{
  "name": "Go 中級講座",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "sudo mkdir -p /project && sudo ln -sfn \"$PWD\" /project/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": true
      }
    },
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  }
}
